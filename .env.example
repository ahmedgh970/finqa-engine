# LLM API Keys
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_TOKEN=hf_...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Phoenix (observability) -- runs 100% locally, no keys needed.
# Only set this if the collector runs elsewhere than the default local endpoint.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Project paths (overridable, defaults to repo root)
DATA_DIR=./data

# Default LLM
DEFAULT_LLM_MODEL=ollama_chat/llama3.1:8b
